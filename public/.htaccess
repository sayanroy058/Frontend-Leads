# SPA fallback — serve index.html for client-side routes (e.g. /app, /app/chat)
# so direct URL access works on static hosting (Apache/LiteSpeed).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
