# Vite automatically loads this file (instead of .env) for `npm run build` /
# `vite build` — but NOT for `npm run dev`. This keeps a plain production
# build always pointed at the real deployed backend, so it's safe to run
# without remembering to pass VITE_API_URL= manually. See .env for the
# local-dev value (routed through the Vite dev proxy instead).
VITE_API_URL=https://backend-leads.vercel.app/api
