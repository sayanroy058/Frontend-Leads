# Leadflow Frontend — environment variables (Vite exposes only VITE_* vars)
# Copy this file to `.env` / `.env.local`, then run `npm run dev`.

# OPTIONAL — base URL of the Leadflow backend API.
# Leave unset to use the deployed backend (https://backend-leads.vercel.app/api).
# Set to "/api" in local dev to route through the Vite proxy to localhost:3001.
VITE_API_URL=/api
